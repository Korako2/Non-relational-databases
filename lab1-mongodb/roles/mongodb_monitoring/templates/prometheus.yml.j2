global:
    scrape_interval: 5s
    evaluation_interval: 5s

scrape_configs:
    - job_name: "prometheus"
      static_configs:
        - targets:
            - "127.0.0.1:{{ prometheus_port }}"
    - job_name: "mongodb"
      static_configs:
        - targets:
            - "127.0.0.1:{{ mongodb_exporter_port }}"