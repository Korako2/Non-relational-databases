[SERVICE]
    Flush           2
    Daemon          Off
    Log_Level       info
    Parsers_File    /etc/fluent-bit/parsers_lab.conf

[INPUT]
    Name              tail
    Tag               nginx.access
    Path              /var/log/nginx/opensearch-access.json
    Parser            nginx_json
    DB                /var/lib/fluent-bit/nginx-tail.db
    Read_from_Head    On
    Refresh_Interval  2
    Skip_Long_Lines   On
    Mem_Buf_Limit     5MB

[OUTPUT]
    Name                opensearch
    Match               nginx.access

    Host                os-hot.lab.internal
    Port                9200
    Index               logs

    HTTP_User           logs_writer_user
    HTTP_Passwd         {{ rbac_writer_password }}

    Logstash_Format     Off
    Write_Operation     create
    Generate_ID         On
    Suppress_Type_Name  On

    tls                 On
    tls.verify          On
    tls.verify_hostname On
    tls.ca_file         {{ lab_opensearch_conf_dir }}/root-ca.pem

    Retry_Limit         False
    Buffer_Size         1MB