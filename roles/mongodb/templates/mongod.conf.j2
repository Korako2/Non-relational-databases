storage:
    dbPath: {{ mongodb_db_path }}

systemLog:
    destination: file
    logAppend: true
    path: {{ mongodb_log_path }}

net:
    port: {{ mongodb_port }}
    bindIp: {{ mongodb_bind_ip }}

processManagement:
    timeZoneInfo: /usr/share/zoneinfo

{% if mongodb_authorization_enabled %}
security:
  authorization: enabled
{% endif %}