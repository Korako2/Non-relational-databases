{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "MongoDB UP",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "mongodb_up",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
     {
      "type": "timeseries",
      "title": "Current connections",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "mongodb_ss_connections{conn_type=\"current\"}",
          "legendFormat": "connections",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Document operations / sec",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (doc_op_type) (rate(mongodb_ss_metrics_document[1m]))",
          "legendFormat": "{{doc_op_type}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Network traffic",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(mongodb_ss_network_physicalBytesIn[1m])",
          "legendFormat": "in",
          "refId": "A"
        },
        {
          "expr": "rate(mongodb_ss_network_physicalBytesOut[1m])",
          "legendFormat": "out",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "MongoDB resident memory (MiB)",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "mongodb_ss_mem_resident",
          "legendFormat": "resident",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "WiredTiger cache usage (%)",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * mongodb_ss_wt_cache_bytes_currently_in_the_cache / mongodb_ss_wt_cache_maximum_bytes_configured",
          "legendFormat": "cache",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Operation latency (ms/op)",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(mongodb_ss_opLatencies_latency{op_type=\"reads\"}[1m]) / clamp_min(rate(mongodb_ss_opLatencies_ops{op_type=\"reads\"}[1m]), 0.001) / 1000",
          "legendFormat": "reads",
          "refId": "A"
        },
        {
          "expr": "rate(mongodb_ss_opLatencies_latency{op_type=\"writes\"}[1m]) / clamp_min(rate(mongodb_ss_opLatencies_ops{op_type=\"writes\"}[1m]), 0.001) / 1000",
          "legendFormat": "writes",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "mongodb",
    "lab"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "MongoDB Lab Monitoring",
  "uid": "mongodb-lab",
  "version": 1
}