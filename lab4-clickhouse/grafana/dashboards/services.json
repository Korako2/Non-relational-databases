    {
      "id": 9,
      "title": "HTTP status classes",
      "description": "Distribution of 2xx, 4xx, and 5xx responses.",
      "type": "piechart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "pluginVersion": "4.15.0",
          "rawSql": "SELECT concat(toString(intDiv(status_code, 100)), 'xx') AS status_class, count() AS requests FROM lab4.requests WHERE $__timeFilter(timestamp) GROUP BY status_class ORDER BY status_class"
        }
      ],
      "fieldConfig": {
