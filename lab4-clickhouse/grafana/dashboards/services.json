      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "pluginVersion": "4.15.0",
          "rawSql": "SELECT round(avgOrNull(duration_ms), 2) AS avg_ms FROM lab4.requests WHERE $__timeFilter(timestamp)"
