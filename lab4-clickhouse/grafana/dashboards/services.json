    {
      "id": 5,
      "title": "Requests per second by service",
      "description": "Requests in each 10-second bucket divided by 10; edge buckets may be partial.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "pluginVersion": "4.15.0",
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL 10 SECOND) AS time, service, count() / 10.0 AS rps FROM lab4.requests WHERE $__timeFilter(timestamp) GROUP BY time, service ORDER BY time, service"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
