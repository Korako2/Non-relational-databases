    {
      "id": 10,
      "title": "Slowest endpoints (by P95)",
      "description": "Endpoints sorted by P95; HTTP method distinguishes operations on the same route.",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "pluginVersion": "4.15.0",
          "rawSql": "SELECT service, method, endpoint, count() AS requests, round(avg(duration_ms), 1) AS avg_ms, quantileExact(0.95)(duration_ms) AS p95_ms, round(100.0 * countIf(status_code >= 500 AND status_code < 600) / count(), 2) AS error_pct FROM lab4.requests WHERE $__timeFilter(timestamp) GROUP BY service, method, endpoint ORDER BY p95_ms DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
