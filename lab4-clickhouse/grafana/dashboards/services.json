    {
      "id": 4,
      "title": "P95 latency",
      "description": "Exact 95th percentile of response time.",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "pluginVersion": "4.15.0",
          "rawSql": "SELECT round(quantileExact(0.95)(duration_ms), 2) AS p95_ms FROM lab4.requests WHERE $__timeFilter(timestamp) HAVING count() > 0"
        }
      ],
      "fieldConfig": {
        "defaults": {
